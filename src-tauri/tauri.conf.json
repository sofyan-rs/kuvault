{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KuVault",
  "version": "1.0.2",
  "identifier": "KuVault",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build/client",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KuVault",
        "width": 1400,
        "height": 918,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msSmartScreenProtection,ElasticOverscroll --disk-cache-size=52428800"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Kuroneko",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installMode": "currentUser"
      },
      "wix": {
        "template": "wix/main.wxs"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3OUQ3REY4RjJEMTJCMkMKUldRc0s5SHkrSDJkZDFiU052VnVmeE14aUtKQlJyNXFEOHZ2SUtyZUFRek00SitwQkFFdmxXcUQK",
      "endpoints": [
        "https://github.com/sofyan-rs/kuvault/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
