{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KuVault",
  "version": "1.0.0",
  "identifier": "KuVault",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build/client",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KuVault",
        "width": 1400,
        "height": 918,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Kuroneko",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi"
      },
      "wix": {
        "template": "wix/main.wxs"
      }
    }
  }
}
